<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicLayer.Presentation.Maui"
             x:Class="MusicLayer.Presentation.Maui.LibraryPage"
             BackgroundColor="#050D10" Title="Biblioteca" SafeAreaEdges="All">
    <ContentPage.Resources>
        <Color x:Key="Surface">#0B1D22</Color>
        <Color x:Key="Outline">#20483F</Color>
        <Color x:Key="Accent">#25E8A4</Color>
        <Color x:Key="PrimaryText">#F2F8F7</Color>
        <Color x:Key="SecondaryText">#9AB9B5</Color>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
            <Setter Property="TextColor" Value="#041410" />
        </Style>
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{StaticResource Outline}" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="16,8,16,8" RowSpacing="8">
        <local:TonicHeader x:Name="Header" ShowLibraryActions="True"
                           SearchRequested="ToggleSearch" ImportRequested="ChooseSongs" />
        <Border Grid.Row="1" x:Name="SearchPanel" IsVisible="False"
                BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}"
                StrokeShape="RoundRectangle 12" Padding="10,0">
            <Entry x:Name="Search" TextChanged="SearchChanged" ReturnType="Search"
                   MinimumWidthRequest="44" MinimumHeightRequest="44" FontSize="15"
                   Placeholder="Buscar título, artista o álbum" TextColor="{StaticResource PrimaryText}"
                   PlaceholderColor="{StaticResource SecondaryText}" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="4,*" ColumnSpacing="12" Margin="0,4,0,2">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 2" BackgroundColor="{StaticResource Accent}" />
            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="Tu biblioteca" FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryText}" SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="LibrarySummary" FontSize="13" TextColor="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="3" x:Name="LibraryTools" IsVisible="False" Spacing="8">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6">
                    <Button x:Name="SongsFilter" Text="Canciones" Clicked="SelectSection" Style="{StaticResource FilterChip}" />
                    <Button x:Name="ArtistsFilter" Text="Artistas" Clicked="SelectSection" Style="{StaticResource FilterChip}" />
                    <Button x:Name="AlbumsFilter" Text="Álbumes" Clicked="SelectSection" Style="{StaticResource FilterChip}" />
                    <Button x:Name="GenresFilter" Text="Géneros" Clicked="SelectSection" Style="{StaticResource FilterChip}" />
                </HorizontalStackLayout>
            </ScrollView>
            <Border x:Name="GroupBox" IsVisible="False" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{StaticResource Surface}" Padding="8,0">
                <Picker x:Name="GroupPicker" MinimumHeightRequest="44" TextColor="{StaticResource PrimaryText}"
                        TitleColor="{StaticResource SecondaryText}" SelectedIndexChanged="SelectGroup"
                        SemanticProperties.Description="Seleccionar grupo" />
            </Border>
            <Grid ColumnDefinitions="Auto,44,*" ColumnSpacing="6">
                <Button x:Name="PlayAllButton" Text="Reproducir todo" ImageSource="play.png" ContentLayout="Left,4"
                        Clicked="PlayAll" Style="{StaticResource Action}" Padding="8,0" FontSize="12"
                        BackgroundColor="#103832" TextColor="{StaticResource PrimaryText}" BorderWidth="1" BorderColor="#296454" />
                <ImageButton Grid.Column="1" x:Name="ShuffleButton" Source="shuffle.png" Clicked="ToggleShuffle"
                             WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="10"
                             BorderWidth="1" BorderColor="{StaticResource Outline}" BackgroundColor="{StaticResource Surface}" />
                <Border Grid.Column="2" Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Surface}" Padding="6,0">
                    <Picker x:Name="SortPicker" MinimumHeightRequest="44" TextColor="{StaticResource SecondaryText}"
                            TitleColor="{StaticResource SecondaryText}" FontSize="12" SelectedIndexChanged="SelectSort"
                            SemanticProperties.Description="Orden de la biblioteca" />
                </Border>
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="4" x:Name="StateCard" IsVisible="False" Padding="14"
                BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Outline}"
                StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                <Border WidthRequest="36" HeightRequest="36" VerticalOptions="Start"
                        Stroke="{StaticResource Outline}" StrokeShape="RoundRectangle 10" BackgroundColor="#103832">
                    <Grid>
                        <Image x:Name="StateIcon" Source="folder_open.png" WidthRequest="20" HeightRequest="20" />
                        <ActivityIndicator x:Name="ImportProgress" IsVisible="False"
                                           Color="{StaticResource Accent}" WidthRequest="23" HeightRequest="23" />
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label x:Name="StateTitle" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryText}" SemanticProperties.HeadingLevel="Level2" />
                    <Label x:Name="StateMessage" FontSize="14" TextColor="{StaticResource SecondaryText}" />
                    <Button x:Name="RetryImport" Style="{StaticResource Action}" Clicked="ChooseSongs" IsVisible="False" />
                    <Button x:Name="ClearSearch" Style="{StaticResource Action}" Text="Limpiar búsqueda"
                            Clicked="ClearQuery" IsVisible="False" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Label Grid.Row="5" x:Name="ResultCount" IsVisible="False"
               FontSize="13" TextColor="{StaticResource SecondaryText}" />

        <Grid Grid.Row="6" IsClippedToBounds="True">
            <local:LibraryTrackList x:Name="TrackList" TrackTapped="PlayTrack" />
        </Grid>
        <local:MiniPlayer Grid.Row="7" x:Name="MiniPlayer" OpenRequested="OpenPlayback" />
    </Grid>
</ContentPage>
