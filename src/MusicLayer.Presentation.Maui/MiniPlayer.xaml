<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicLayer.Presentation.Maui.MiniPlayer" IsVisible="False">
    <Border BackgroundColor="#0B1D22" Stroke="#296454" StrokeShape="RoundRectangle 12" Padding="8,4">
        <Grid ColumnDefinitions="42,*,44" RowDefinitions="2,Auto" ColumnSpacing="8" RowSpacing="4">
            <ProgressBar x:Name="Progress" Grid.ColumnSpan="3" ProgressColor="#25E8A4" BackgroundColor="#20483F" />
            <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                    WidthRequest="42" HeightRequest="42" BackgroundColor="#103832">
                <Image x:Name="Cover" Aspect="AspectFill" />
            </Border>
            <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center" InputTransparent="True">
                <Label x:Name="TrackTitle" TextColor="#F2F8F7" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                <Label x:Name="Credits" TextColor="#9AB9B5" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Row="1" Grid.ColumnSpan="2" Clicked="Open" BackgroundColor="Transparent" MinimumHeightRequest="44"
                    SemanticProperties.Description="Abrir reproducción" />
            <ImageButton Grid.Row="1" Grid.Column="2" x:Name="ToggleButton" Clicked="Toggle" BackgroundColor="#25E8A4"
                         WidthRequest="44" HeightRequest="44" Padding="11" CornerRadius="22" />
        </Grid>
    </Border>
</ContentView>
