<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicLayer.Presentation.Maui"
             x:Class="MusicLayer.Presentation.Maui.PlaybackPage" Title="Reproducción"
             BackgroundColor="#050D10" SafeAreaEdges="All">
    <ContentPage.Resources>
        <Style x:Key="TransportButton" TargetType="ImageButton">
            <Setter Property="MinimumWidthRequest" Value="44" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BackgroundColor" Value="#0B1D22" />
            <Setter Property="BorderColor" Value="#20483F" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">
        <local:TonicHeader />
        <CollectionView Grid.Row="1" x:Name="QueueList" SelectionMode="Single" SelectionChanged="SelectTrack">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,4,0,12">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                        <Button Text="⌄" Clicked="ReturnToLibrary" MinimumWidthRequest="44" MinimumHeightRequest="44"
                                Padding="0" FontSize="22" CornerRadius="12" TextColor="#9AB9B5"
                                BackgroundColor="#0B1D22" BorderColor="#20483F" BorderWidth="1"
                                SemanticProperties.Description="Volver a Biblioteca" />
                        <Grid Grid.Column="1" ColumnDefinitions="6,*" ColumnSpacing="6" VerticalOptions="Center">
                            <BoxView x:Name="PlaybackIndicator" Color="#25E8A4" WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                     VerticalOptions="Center" IsVisible="False" />
                            <Label x:Name="PlaybackHeading" Grid.Column="1" Text="Reproducción" FontSize="12" FontAttributes="Bold"
                                   TextColor="#F2F8F7" VerticalOptions="Center" />
                        </Grid>
                        <Button Grid.Column="2" Text="Letras" Clicked="ShowLyricsPlaceholder"
                                MinimumHeightRequest="44" Padding="10,0" FontSize="12" FontAttributes="Bold"
                                CornerRadius="22" BackgroundColor="#103832" TextColor="#25E8A4"
                                BorderColor="#296454" BorderWidth="1" />
                    </Grid>
                    <Border x:Name="ArtworkFrame" HorizontalOptions="Center" WidthRequest="244" HeightRequest="244" Margin="0,14,0,0"
                            BackgroundColor="#0B1D22" Stroke="#296454" StrokeShape="RoundRectangle 22">
                        <Image x:Name="Artwork" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Margin="4,16,4,0" Spacing="3">
                        <Label x:Name="TrackTitle" TextColor="#F2F8F7" FontSize="26" FontAttributes="Bold"
                               MaxLines="2" LineBreakMode="TailTruncation" SemanticProperties.HeadingLevel="Level1" />
                        <Label x:Name="Credits" TextColor="#9AB9B5" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Grid x:Name="AudioInfo" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False" Margin="0,4,0,0">
                            <Border Stroke="#296454" StrokeShape="RoundRectangle 7" BackgroundColor="#103832" Padding="8,3">
                                <Label x:Name="Format" TextColor="#25E8A4" FontSize="11" FontAttributes="Bold" />
                            </Border>
                            <Label x:Name="TechnicalInfo" Grid.Column="1" TextColor="#9AB9B5" FontSize="12"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label x:Name="Status" TextColor="#FFC58F" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Margin="4,12,4,0">
                        <Slider x:Name="Position" Maximum="1" MinimumTrackColor="#25E8A4" MaximumTrackColor="#20483F" ThumbColor="#25E8A4"
                                DragStarted="StartSeek" DragCompleted="CompleteSeek" ValueChanged="PositionChanged"
                                SemanticProperties.Description="Posición de reproducción" />
                        <Grid ColumnDefinitions="*,*">
                            <Label x:Name="Elapsed" TextColor="#9AB9B5" FontSize="12" />
                            <Label x:Name="Duration" Grid.Column="1" TextColor="#9AB9B5" FontSize="12" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                    <Grid x:Name="Transport" ColumnDefinitions="*,48,60,48,*" ColumnSpacing="8" Margin="4,16,4,0">
                        <ImageButton x:Name="ShuffleButton" Source="shuffle.png" Clicked="Shuffle" Style="{StaticResource TransportButton}"
                                     SemanticProperties.Description="Modo aleatorio" />
                        <ImageButton Grid.Column="1" Source="circle_chevron_left.png" Clicked="Previous" Style="{StaticResource TransportButton}"
                                     SemanticProperties.Description="Anterior" />
                        <ImageButton Grid.Column="2" x:Name="PlayButton" Clicked="Toggle" Style="{StaticResource TransportButton}"
                                     WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="14"
                                     BorderWidth="0" BackgroundColor="#25E8A4" />
                        <ImageButton Grid.Column="3" Source="circle_chevron_right.png" Clicked="Next" Style="{StaticResource TransportButton}"
                                     SemanticProperties.Description="Siguiente" />
                        <ImageButton Grid.Column="4" x:Name="RepeatButton" Clicked="Repeat" Style="{StaticResource TransportButton}"
                                     SemanticProperties.Description="Repetición" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#20483F" Margin="0,16,0,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,10,4,0">
                        <Label Text="Cola de reproducción" TextColor="#F2F8F7" FontSize="18" FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Grid.Column="1" x:Name="QueueSummary" TextColor="#9AB9B5" FontSize="12" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="EmptyQueue" Text="Elegí una canción en Biblioteca para empezar."
                           TextColor="#9AB9B5" FontSize="14" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaybackQueueRow">
                    <Border BackgroundColor="#0B1D22" Stroke="#20483F" StrokeShape="RoundRectangle 10" Padding="8,5">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BackgroundColor" Value="#103832" />
                                <Setter Property="Stroke" Value="#25E8A4" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" MinimumHeightRequest="44">
                            <Image Source="{Binding Artwork}" WidthRequest="32" HeightRequest="32" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" TextColor="#F2F8F7" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Credits}" TextColor="#9AB9B5" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Duration}" TextColor="#9AB9B5" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
