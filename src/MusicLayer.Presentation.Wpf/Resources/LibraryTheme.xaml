<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:local="clr-namespace:MusicLayer.Presentation.Wpf.Views">
    <BitmapImage x:Key="LibraryArtwork" UriSource="Art/LibraryArtwork.png" />
    <x:Array x:Key="Sections" Type="{x:Type sys:String}"><sys:String>Canciones</sys:String><sys:String>Artistas</sys:String><sys:String>Álbumes</sys:String><sys:String>Géneros</sys:String><sys:String>Favoritas</sys:String><sys:String>Recientes</sys:String></x:Array>
    <local:CurrentRowConverter x:Key="CurrentRow" />
    <BooleanToVisibilityConverter x:Key="VisibleIf" />
    <SolidColorBrush x:Key="Mint" Color="#48EDBD" />
    <SolidColorBrush x:Key="Muted" Color="#B0C6CF" />
    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DE0B1C24" Offset="0" />
        <GradientStop Color="#C10B252C" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="FavoriteToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Añadir a favoritas" />
        <Setter Property="AutomationProperties.ItemStatus" Value="Sin marcar" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="#B310242C" BorderBrush="#425A61" BorderThickness="1" CornerRadius="9">
                        <TextBlock x:Name="Heart" Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F4F9F8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#235256" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#175347" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#48EDBD" />
                            <Setter TargetName="Heart" Property="Text" Value="&#xEB52;" />
                            <Setter TargetName="Heart" Property="Foreground" Value="#7FFFD4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#2B7164" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value=".48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="En favoritas · Quitar" />
                <Setter Property="AutomationProperties.ItemStatus" Value="Marcada como favorita" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#304950" />
        <Setter Property="Background" Value="{StaticResource Glass}" />
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="LibraryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="#EAF6F8" />
        <Setter Property="Background" Value="#B310242C" /><Setter Property="BorderBrush" Value="#425A61" />
        <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="12,2" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1A494C" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#196556" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".48" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Pill" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,7,4" />
        <Setter Property="Foreground" Value="#DBE9ED" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chip" Padding="13,6" CornerRadius="17" BorderBrush="#4C6870" BorderThickness="1" Background="#B3142931">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Icon" Text="&#xE8D6;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Content" Value="Artistas"><Setter TargetName="Icon" Property="Text" Value="&#xE77B;" /></Trigger>
                    <Trigger Property="Content" Value="Álbumes"><Setter TargetName="Icon" Property="Text" Value="&#xE93C;" /></Trigger>
                    <Trigger Property="Content" Value="Géneros"><Setter TargetName="Icon" Property="Text" Value="&#xE8EC;" /></Trigger>
                    <Trigger Property="Content" Value="Favoritas"><Setter TargetName="Icon" Property="Text" Value="&#xEB51;" /></Trigger>
                    <Trigger Property="Content" Value="Recientes"><Setter TargetName="Icon" Property="Text" Value="&#xE823;" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#20464C" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource Mint}" />
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Mint}" />
                        <Setter Property="Foreground" Value="#082925" /><Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="White" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="TableRow" TargetType="ListBoxItem">
        <Setter Property="Tag"><Setter.Value>
            <MultiBinding Converter="{StaticResource CurrentRow}">
                <Binding Path="Index" /><Binding Path="DataContext.CurrentSongIndex" RelativeSource="{RelativeSource AncestorType=ListBox}" />
            </MultiBinding>
        </Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="#ECF6F8" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Height="42" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#263E44" Padding="6,0">
                    <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1A383D" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#205E66" /><Setter TargetName="Surface" Property="CornerRadius" Value="7" /></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter TargetName="Surface" Property="CornerRadius" Value="7" /><Setter TargetName="Surface" Property="Background" Value="#16453E" />
                        <Setter TargetName="Surface" Property="BorderBrush" Value="#287D70" /><Setter Property="AutomationProperties.ItemStatus" Value="Pista actual" />
                    </DataTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
