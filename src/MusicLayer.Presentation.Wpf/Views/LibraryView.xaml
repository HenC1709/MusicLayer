<UserControl x:Class="MusicLayer.Presentation.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:MusicLayer.Presentation.Wpf.Views"
             x:Name="View" SizeChanged="ResizeView" Foreground="#F2F8FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LibraryTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Layout" Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TopBar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource LibraryButton}" Padding="0" Width="28" Height="28" ToolTip="Atrás" AutomationProperties.Name="Atrás" Click="GoBack" IsEnabled="{Binding CanGoBack, ElementName=View}">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="11" />
                </Button>
                <Button Style="{StaticResource LibraryButton}" Padding="0" Width="28" Height="28" Margin="5,0,15,0" ToolTip="Adelante" AutomationProperties.Name="Adelante" Click="GoForward" IsEnabled="{Binding CanGoForward, ElementName=View}">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="11" />
                </Button>
                <TextBlock Text="Biblioteca" Foreground="{StaticResource Muted}" />
                <TextBlock Text="›" Margin="10,0" Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Library.Section}" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" MaxWidth="440" Height="36" HorizontalAlignment="Stretch" Background="#850B202A" BorderThickness="1" BorderBrush="#47616A" CornerRadius="18" Padding="12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                    <TextBlock x:Name="Shortcut" DockPanel.Dock="Right" Text="Ctrl + F" Style="{StaticResource SmallLabel}" FontSize="11" Margin="6,0" />
                    <Grid>
                        <TextBlock IsHitTestVisible="False" Text="Buscar en tu biblioteca…" Foreground="{StaticResource Muted}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="White"
                                 Background="Transparent" BorderThickness="0" Padding="0" CaretBrush="White" VerticalContentAlignment="Center" AutomationProperties.Name="Buscar en tu biblioteca" />
                    </Grid>
                </DockPanel>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource LibraryButton}" Margin="12,0,0,0" Background="#AD10413B" BorderBrush="#299E8A"
                    AutomationProperties.Name="Importar carpeta" Click="ImportFolder" IsEnabled="{Binding IsReady}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Foreground="{StaticResource Mint}" Margin="0,0,8,0" /><TextBlock Text="Importar carpeta" FontWeight="SemiBold" /></StackPanel>
            </Button>
        </Grid>
        <DockPanel x:Name="Heading" Grid.Row="1" Margin="0,20,0,16">
            <Border DockPanel.Dock="Left" Width="3" Margin="0,4,16,6" CornerRadius="2" Background="{StaticResource Mint}" />
            <StackPanel>
                <TextBlock x:Name="Title" Text="Tu biblioteca" FontSize="38" FontWeight="Bold" />
                <TextBlock x:Name="Summary" Text="{Binding Library.Summary}" Style="{StaticResource SmallLabel}" FontSize="13" />
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="CategoryTabs" ItemsSource="{StaticResource Sections}" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12"
                 SelectedItem="{Binding Library.Section, Mode=TwoWay}" AutomationProperties.Name="Categorías de biblioteca"
                 ItemContainerStyle="{StaticResource Pill}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>

        </ListBox>

        <ComboBox x:Name="CompactCategory" Grid.Row="2" ItemsSource="{StaticResource Sections}" SelectedItem="{Binding Library.Section, Mode=TwoWay}" AutomationProperties.Name="Categoría de biblioteca" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="145" Margin="0,2,0,3" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailColumn" Width="0.4*" MaxWidth="392" /></Grid.ColumnDefinitions>
            <Grid x:Name="TracksPanel">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel x:Name="Toolbar" Margin="0,7,0,12">
                    <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource LibraryButton}" Padding="8,0" Click="OpenSortMenu" ToolTip="Ordenar canciones" AutomationProperties.Name="Ordenar canciones">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Título" Click="ChooseSort" /><MenuItem Header="Artista" Click="ChooseSort" />
                            <MenuItem Header="Álbum" Click="ChooseSort" /><MenuItem Header="Duración" Click="ChooseSort" />
                            <MenuItem Header="Orden de carpeta" Click="ChooseSort" />
                        </ContextMenu></Button.ContextMenu>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" FontSize="13" />
                            <TextBlock x:Name="SortLabel" Text="{Binding Library.SortOrder}" Margin="7,0,0,0" />
                            <TextBlock Text="▾" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LibraryButton}" Width="32" Padding="0" Margin="0,0,6,0" ToolTip="Reproducir una pista al azar" AutomationProperties.Name="Reproducir una pista al azar" Click="PlayRandom" IsEnabled="{Binding Library.HasResults}">
                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" />
                    </Button>
                    <Button x:Name="PlayVisibleButton" DockPanel.Dock="Right" Style="{StaticResource LibraryButton}" Margin="0,0,6,0" BorderBrush="#287966" Click="PlayVisible" IsEnabled="{Binding Library.HasResults}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Foreground="{StaticResource Mint}" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Reproducir" /></StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Library.ResultCount}" VerticalAlignment="Center" Style="{StaticResource SmallLabel}" Margin="4,0,6,0" />
                </DockPanel>
                <ComboBox Grid.Row="1" x:Name="GroupPicker" ItemsSource="{Binding Library.Groups}" SelectedItem="{Binding Library.Group, Mode=TwoWay}"
                          Visibility="{Binding Library.IsGrouped, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Elegir grupo" Margin="0,0,0,6" />
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="6,4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="ColumnHeaders" Margin="6,4,8,4" Height="25" ClipToBounds="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.HasResults}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/><ColumnDefinition Width="39"/><ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="{DynamicResource ArtistColumn}"/><ColumnDefinition Width="{DynamicResource AlbumColumn}"/>
                                <ColumnDefinition Width="{DynamicResource TimeColumn}"/><ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource SmallLabel}" />
                            <TextBlock Grid.Column="2" Text="TÍTULO" Style="{StaticResource SmallLabel}" FontSize="10" />
                            <TextBlock Grid.Column="3" Text="ARTISTA" Style="{StaticResource SmallLabel}" FontSize="10" />
                            <TextBlock Grid.Column="4" Text="ÁLBUM" Style="{StaticResource SmallLabel}" FontSize="10" />
                            <TextBlock Grid.Column="5" Text="TIEMPO" Style="{StaticResource SmallLabel}" FontSize="10" />
                            <TextBlock Grid.Column="6" Text="ESTADO" Style="{StaticResource SmallLabel}" FontSize="9" />
                        </Grid>
                        <ListBox x:Name="SongList" Grid.Row="1" ItemsSource="{Binding Library.Rows}" SelectedItem="{Binding SelectedLibraryRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource TableRow}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="ActivateRow" PreviewKeyDown="ActivateRowFromKeyboard" AutomationProperties.Name="Canciones en la biblioteca">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid ToolTip="{Binding Song.FilePath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="39"/><ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="{DynamicResource ArtistColumn}"/><ColumnDefinition Width="{DynamicResource AlbumColumn}"/>
                                        <ColumnDefinition Width="{DynamicResource TimeColumn}"/><ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SmallLabel}">
                                        <Setter Property="Text" Value="{Binding Number}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="Text" Value="&#xE9D9;" />
                                            <Setter Property="Foreground" Value="{StaticResource Mint}" />
                                        </DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style></TextBlock>
                                    <Border x:Name="MiniArt" Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="4"
                                            Background="#0E2933" ClipToBounds="True">
                                        <Image Loaded="LoadRowArt" Unloaded="UnloadRowArt" DataContextChanged="ChangeRowArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Song.DisplayName}" Margin="0,0,9,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Song.Metadata.Artist, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource SmallLabel}" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Song.Metadata.Album, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource SmallLabel}" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" Style="{StaticResource SmallLabel}" />
                                    <ToggleButton Grid.Column="6" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Focusable="True"
                                                  ToolTip="Marcar o quitar favorita" AutomationProperties.Name="{Binding Song.DisplayName, StringFormat='Favorita · {0}'}" Cursor="Hand">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeartSurface" Background="Transparent" BorderThickness="1" CornerRadius="6" Width="28" Height="28">
                                                <TextBlock x:Name="Heart" Text="&#xEB51;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Heart" Property="Text" Value="&#xEB52;" /><Setter TargetName="Heart" Property="Foreground" Value="{StaticResource Mint}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeartSurface" Property="BorderBrush" Value="White" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeartSurface" Property="Background" Value="#235256" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer x:Name="EmptyState" Grid.RowSpan="2" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,2">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.HasResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Notice}" Value="Importing">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <Border Style="{DynamicResource StatusCard}" MaxWidth="460">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="37" Height="37" VerticalAlignment="Top"
                                            Margin="0,0,10,0" CornerRadius="8" Background="#183941">
                                        <TextBlock Text="&#xE8F1;" Style="{DynamicResource StatusGlyph}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="No hay canciones en esta selección" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                                            <Setter Property="Text" Value="Tu biblioteca está vacía" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Songs.Count}" Value="0" />
                                                                <Condition Binding="{Binding HasImportedFolder}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="Sin canciones compatibles" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Elige una carpeta con archivos MP3, WAV o FLAC."
                                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,4" />
                                            <Button x:Name="EmptyImportButton" Content="Importar carpeta" Click="ImportFolder"
                                                    IsEnabled="{Binding IsReady}" Style="{DynamicResource StatusAction}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="Detail" Grid.Column="1" Style="{StaticResource Panel}" Padding="14" Margin="15,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                              SizeChanged="ResizeDetail">
                    <StackPanel>
                        <Border x:Name="ArtFrame" HorizontalAlignment="Center" CornerRadius="14" BorderThickness="1" BorderBrush="#436068">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverImage, TargetNullValue={StaticResource LibraryArtwork}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="DetailTitle" Text="{Binding CoverSong.DisplayName, FallbackValue=Sin pista activa}"
                                   ToolTip="{Binding CoverSong.DisplayName}" TextWrapping="Wrap" FontWeight="Bold" FontSize="27" Margin="0,13,0,4" />
                        <StackPanel x:Name="DetailsMetadata">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CoverSong}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="{Binding CoverDescription}" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CoverSong.Metadata.Artist, FallbackValue={x:Null}}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding CoverSong.Metadata.Album, FallbackValue={x:Null}}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DockPanel HorizontalAlignment="Left" Margin="0,11,0,0">
                                <Border BorderThickness="1" BorderBrush="#52858A" CornerRadius="3" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding CoverSong.FileFormat}" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding CoverLabel}" Style="{StaticResource SmallLabel}" />
                            </DockPanel>
                            <TextBlock Text="{Binding CoverAudioDetails}" Style="{StaticResource SmallLabel}" Margin="0,4,0,0" />
                            <DockPanel Margin="0,10,0,0" ToolTip="{Binding CoverSong.FilePath}" Opacity=".72">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" Style="{StaticResource Glyph}"
                                           FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                                <TextBlock x:Name="DetailSource" Text="{Binding CoverSong.FolderName, StringFormat='Carpeta · {0}'}"
                                           Style="{StaticResource SmallLabel}" FontSize="11" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
