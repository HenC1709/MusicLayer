<Window x:Class="MusicLayer.Presentation.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicLayer" Width="640" Height="440" MinWidth="400" MinHeight="300">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Content="Elegir carpeta" Click="ChooseFolder" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" Padding="14,7" />
        <ListBox Grid.Row="1" Margin="0,16" DisplayMemberPath="DisplayName" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" />
        <Button Grid.Row="2" Content="Reproducir seleccionada" Click="PlaySelected" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" Padding="14,7" />
        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
    </Grid>
</Window>
