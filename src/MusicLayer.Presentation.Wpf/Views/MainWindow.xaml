<Window x:Class="MusicLayer.Presentation.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MusicLayer.Presentation.Wpf.Views"
        Title="Tonic" Icon="../Resources/Art/tonic.ico" Width="1120" Height="720" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlayerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ImageBrush x:Key="LibraryAmbient" ImageSource="../Resources/Art/LibraryAmbient.png" Stretch="Fill" />
            <Style x:Key="RailLink" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="ContentTemplate">
                    <Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Width="23" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="{Binding}" Margin="9,0,0,0" />
                    </StackPanel></DataTemplate></Setter.Value>
                </Setter>
            </Style>
            <Thickness x:Key="MenuRoutePadding">12,8</Thickness>
            <Style x:Key="MenuRoute" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="{DynamicResource MenuRoutePadding}" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="RouteFrame" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="›" FontSize="19" Margin="8,0,0,0"
                                                   Foreground="{StaticResource SecondaryBrush}" />
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                                   Width="30" Margin="0,0,9,0" Text="{TemplateBinding Tag}" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="ActiveMark" HorizontalAlignment="Left" Width="3" CornerRadius="2"
                                        Margin="3,8,0,8" Background="#48EDBD" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RouteFrame" Property="Background" Value="#163439" />
                                </Trigger>
                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter TargetName="RouteFrame" Property="Background" Value="#123936" />
                                    <Setter TargetName="RouteFrame" Property="BorderBrush" Value="#36736C" />
                                    <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Sección actual" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="RouteFrame" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RouteFrame" Property="Opacity" Value=".45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryTransport" TargetType="Button" BasedOn="{StaticResource Transport}">
                <Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="#48EDBD" CornerRadius="24" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#92FFDB" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value=".45" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="NavigationRail" Background="#0C171F" BorderBrush="#304047" BorderThickness="0,0,1,0" Padding="8,16" ClipToBounds="True">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="7,5,0,12">
                        <Image x:Name="TonicLogo" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="Brand" Text="Tonic" FontSize="22" Margin="9,0,0,0" FontWeight="Bold" />
                    </StackPanel>
                    <Button x:Name="NavigationMenuButton" DockPanel.Dock="Top" Click="OpenNavigationMenu" Margin="0,0,0,9"
                            Padding="8,4" Background="{StaticResource RaisedBrush}" BorderBrush="#304950"
                            ToolTip="Abrir menú de navegación" AutomationProperties.Name="Abrir menú de navegación">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock x:Name="MenuButtonLabel" Text="Menú" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="Library" Content="Biblioteca" Tag="&#xE8F1;" ToolTip="Biblioteca" GroupName="Screen" Style="{StaticResource RailLink}" IsChecked="True" />
                        <RadioButton x:Name="NowPlaying" Content="Reproducción" Tag="&#xE768;" ToolTip="Reproducción" GroupName="Screen" Style="{StaticResource RailLink}" />
                        <RadioButton x:Name="LyricsTab" Content="Letras" Tag="&#xE8A4;" ToolTip="Letras" GroupName="Screen" Style="{StaticResource RailLink}" IsChecked="{Binding Lyrics.IsOpen, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="FolderInfo" Margin="10,5">
                        <TextBlock Text="Carpeta de música" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LibraryFolder, TargetNullValue=Sin carpeta}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryFolder}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="ScreenHost" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="{StaticResource LibraryAmbient}">
                    <Grid.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" /></Grid.Resources>
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Library}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></Grid.Style>
                    <views:LibraryView x:Name="LibraryScreen" ImportRequested="ChooseFolder" />
                </Grid>
                <views:LyricsView DataContext="{Binding Lyrics}"
                                  AmbientCover="{Binding DataContext.AmbientCoverImage, RelativeSource={RelativeSource AncestorType=Window}}">
                    <views:LyricsView.Style>
                        <Style TargetType="views:LyricsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </views:LyricsView.Style>
                    <views:LyricsView.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" /></views:LyricsView.Resources>
                </views:LyricsView>
                <views:NowPlayingView x:Name="NowPlayingScreen" ImportRequested="ChooseFolder" LyricsRequested="ShowLyrics">
                    <views:NowPlayingView.Style>
                        <Style TargetType="views:NowPlayingView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:NowPlayingView.Style>
                </views:NowPlayingView>

                <Border x:Name="StatusBanner" Grid.Row="1" Margin="16,0,16,4" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="3,2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="Importing">
                                    <Setter Property="Background" Value="#12323B" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Notice}" Value="Imported">
                                    <Setter Property="Background" Value="#163832" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                    <Setter Property="Background" Value="#35252B" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Notice}" Value="FolderError">
                                    <Setter Property="Background" Value="#35252B" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="RetryPlaybackButton" Content="Reintentar" Click="RetryPlayback" Margin="6,2,0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StatusAction}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRetryPlayback}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="AnotherSongButton" Content="Elegir otra canción" Click="ChooseAnotherSong"
                                        IsEnabled="{Binding IsReady}" Margin="6,2,0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StatusAction}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="ImportRecoveryButton" Content="Elegir carpeta" Click="ChooseFolder"
                                        IsEnabled="{Binding IsReady}" Margin="6,2,0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StatusAction}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notice}" Value="FolderError">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="ImportedLibraryButton" Content="Ver biblioteca" Click="ChooseAnotherSong"
                                        IsEnabled="{Binding IsReady}" Margin="6,2,0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StatusAction}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notice}" Value="Imported">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusGlyph}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notice}" Value="Importing">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE895;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Notice}" Value="Imported">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="#FFC0B6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Notice}" Value="FolderError">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="#FFC0B6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notice}" Value="Information">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Notice}" Value="Error">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Notice}" Value="Importing">
                                                    <Setter Property="Text" Value="Importando música" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Notice}" Value="Imported">
                                                    <Setter Property="Text" Value="Importación completada" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                                    <Setter Property="Text" Value="Error de reproducción" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Notice}" Value="FolderError">
                                                    <Setter Property="Text" Value="No se pudo importar la carpeta" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" ToolTip="{Binding StatusDetail}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding PreferencesWarning}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreferencesWarning}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="NavigationOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border x:Name="NavigationBackdrop" Background="#A9040B11" MouseLeftButtonDown="DismissNavigationBackdrop" />
                <Border x:Name="NavigationPanel" Width="382" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,12,10,12" Padding="14"
                        BorderBrush="#345B62" BorderThickness="1" CornerRadius="16"
                        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                        AutomationProperties.Name="Menú de navegación">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#112C35" Offset="0" />
                            <GradientStop Color="#0C1B24" Offset=".36" />
                            <GradientStop Color="#0D2930" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="3,0,1,9">
                            <Button x:Name="CloseNavigationButton" DockPanel.Dock="Right" Padding="7,3" Width="34"
                                    Background="{StaticResource RaisedBrush}" BorderBrush="#34515A" Click="DismissNavigationMenu"
                                    ToolTip="Cerrar menú (Escape)" AutomationProperties.Name="Cerrar menú">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                            <Image DockPanel.Dock="Left" Width="37" Height="37" Margin="0,0,11,0"
                                   Source="{Binding Source, ElementName=TonicLogo}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tonic" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Menú de navegación" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" />
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <Button x:Name="MenuLibrary" Style="{StaticResource MenuRoute}" Tag="&#xE8F1;"
                                        Selector.IsSelected="{Binding IsChecked, ElementName=Library, Mode=OneWay}"
                                        CommandParameter="{Binding ElementName=Library}" Click="NavigateFromMenu" AutomationProperties.Name="Biblioteca">
                                    <StackPanel>
                                        <TextBlock Text="Biblioteca" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Canciones, artistas y álbumes" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuNowPlaying" Style="{StaticResource MenuRoute}" Tag="&#xE768;"
                                        Selector.IsSelected="{Binding IsChecked, ElementName=NowPlaying, Mode=OneWay}"
                                        CommandParameter="{Binding ElementName=NowPlaying}" Click="NavigateFromMenu" AutomationProperties.Name="Reproducción">
                                    <StackPanel>
                                        <TextBlock Text="Reproducción" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Pista actual y cola" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuLyrics" Style="{StaticResource MenuRoute}" Tag="&#xE8A4;"
                                        Selector.IsSelected="{Binding IsChecked, ElementName=LyricsTab, Mode=OneWay}"
                                        CommandParameter="{Binding ElementName=LyricsTab}" Click="NavigateFromMenu" AutomationProperties.Name="Letras">
                                    <StackPanel>
                                        <TextBlock Text="Letras" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Letra de la pista actual" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuImport" Style="{StaticResource MenuRoute}" Tag="&#xE8B7;"
                                        Click="ImportFromMenu" IsEnabled="{Binding IsReady}" AutomationProperties.Name="Importar música">
                                    <StackPanel>
                                        <TextBlock Text="Importar música" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Añade una carpeta con MP3, WAV o FLAC" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Background="#0B1820" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource LibraryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" MinWidth="200" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <Image Width="44" Height="44" Margin="0,0,10,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{Binding CoverImage, TargetNullValue={StaticResource Cover}}" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentSong}" Value="{x:Null}">
                                    <Setter Property="Source" Value="{StaticResource Cover}" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSong.DisplayName, FallbackValue=Sin pista activa}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentSong.Metadata.Artist, FallbackValue='', TargetNullValue=''}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Transport}" Click="PlayPrevious" ToolTip="Anterior" IsEnabled="{Binding CanPrevious}">
                            <Image Source="{StaticResource Back}" Width="18" />
                        </Button>
                        <Button Style="{StaticResource PrimaryTransport}" Click="TogglePlayback" ToolTip="{Binding TransportLabel}"
                                IsEnabled="{Binding CanTogglePlayback}"
                                BorderBrush="{StaticResource AccentBrush}">
                            <Grid>
                                <Path Data="M 1,0 L 15,8 L 1,16 Z" Fill="#092A26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></Path.Style>
                                </Path>
                                <Path Data="M 0,0 h5 v16 h-5 Z M 9,0 h5 v16 h-5 Z" Fill="#092A26">
                                    <Path.Style><Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger></Style.Triggers>
                                    </Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="PlayNext" ToolTip="Siguiente" IsEnabled="{Binding CanNext}">
                            <Image Source="{StaticResource Next}" Width="18" />
                        </Button>
                        <Button x:Name="RandomNextButton" Style="{StaticResource Transport}" Click="PlayRandomNext"
                                ToolTip="Siguiente aleatoria" IsEnabled="{Binding CanRandomNext}">
                            <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="Stop" ToolTip="Detener" IsEnabled="{Binding CanStop}">
                            <Border Width="12" Height="12" Background="{StaticResource InkBrush}" CornerRadius="2" />
                        </Button>
                    </StackPanel>
                    <DockPanel Margin="0,5,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ElapsedTimeText}" Style="{StaticResource Caption}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}" />
                        <Slider x:Name="SeekSlider" Style="{StaticResource PlaybackSlider}" Margin="9,0"
                                Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="Posición de reproducción" IsEnabled="{Binding CanSeek}"
                                ValueChanged="SeekSliderChanged" IsEnabledChanged="SeekSliderEnabledChanged"
                                Thumb.DragStarted="SeekDragStarted" Thumb.DragCompleted="SeekDragCompleted" />
                    </DockPanel>
                </StackPanel>
                <DockPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"
                           IsEnabled="{Binding IsReady}">
                    <Image DockPanel.Dock="Left" Source="{StaticResource Volume}" Width="20" Margin="0,0,6,0" />
                    <TextBlock DockPanel.Dock="Right" MinWidth="32" TextAlignment="Right" Style="{StaticResource Caption}"
                               Text="{Binding VolumePercent, StringFormat={}{0}%}" />
                    <Slider Style="{StaticResource PlaybackSlider}" Width="84" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" AutomationProperties.Name="Volumen"
                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
