<Window x:Class="MusicLayer.Presentation.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MusicLayer.Presentation.Wpf.Views"
        Title="Tonic" Icon="../Resources/Art/tonic.ico" Width="1120" Height="720" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlayerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ImageBrush x:Key="LibraryAmbient" ImageSource="../Resources/Art/LibraryAmbient.png" Stretch="Fill" />
            <Style x:Key="RailLink" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="ContentTemplate">
                    <Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Width="23" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        <TextBlock Text="{Binding}" Margin="9,0,0,0" />
                    </StackPanel></DataTemplate></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryTransport" TargetType="Button" BasedOn="{StaticResource Transport}">
                <Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" Background="#48EDBD" CornerRadius="24" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#92FFDB" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value=".45" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="178" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#0C171F" BorderBrush="#304047" BorderThickness="0,0,1,0" Padding="8,16" ClipToBounds="True">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="7,5,0,36">
                        <Image x:Name="TonicLogo" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="Brand" Text="Tonic" FontSize="22" Margin="9,0,0,0" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="Library" Content="Biblioteca" Tag="&#xE8F1;" ToolTip="Biblioteca" GroupName="Screen" Style="{StaticResource RailLink}" IsChecked="True" />
                        <RadioButton x:Name="NowPlaying" Content="Reproducción" Tag="&#xE768;" ToolTip="Reproducción" GroupName="Screen" Style="{StaticResource RailLink}" />
                        <RadioButton x:Name="LyricsTab" Content="Letras" Tag="&#xE8A4;" ToolTip="Letras" GroupName="Screen" Style="{StaticResource RailLink}" IsChecked="{Binding Lyrics.IsOpen, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" x:Name="FolderInfo" Margin="10,5">
                        <TextBlock Text="Carpeta de música" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LibraryFolder, TargetNullValue=Sin carpeta}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryFolder}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="{StaticResource LibraryAmbient}">
                    <Grid.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" /></Grid.Resources>
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Library}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></Grid.Style>
                    <views:LibraryView x:Name="LibraryScreen" ImportRequested="ChooseFolder" />
                </Grid>
                <Grid Margin="20,16,20,6">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=Library}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ChooseFolder" IsEnabled="{Binding IsReady}" AutomationProperties.Name="Importar carpeta"
                            Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LibraryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Add}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="Importar carpeta" />
                        </StackPanel>
                    </Button>
                    <Grid>
                        <TextBlock FontSize="28" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="Tu biblioteca" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                        <Setter Property="Text" Value="Ahora suena" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="13"
                            Padding="12,8" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0"
                                   Source="{Binding CoverImage, TargetNullValue={StaticResource Cover}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CoverLabel}" Margin="12,0,0,0"
                                       Style="{StaticResource Caption}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CoverSong.DisplayName, FallbackValue=Sin pista activa}"
                                           FontSize="18" FontWeight="SemiBold" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock Text="{Binding CoverDescription}" Style="{StaticResource Caption}"
                                           ToolTip="{Binding CoverDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="2*" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                        <Setter Property="Width" Value="1.1*" />
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource LibraryBrush}" CornerRadius="13" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                    <Setter Property="Grid.Column" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers><DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="3,0,3,10">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="8,2">
                                        <TextBlock Text="{Binding Songs.Count}" AutomationProperties.Name="Número de canciones" />
                                    </Border>
                                    <TextBlock FontSize="17" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="Canciones" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                                    <Setter Property="Text" Value="Cola de reproducción" />
                                                </DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <ListBox x:Name="SongList" Grid.Row="1" Background="Transparent"
                                         BorderThickness="0" Padding="0" Foreground="{StaticResource InkBrush}"
                                         AutomationProperties.Name="Canciones en orden de reproducción" ItemsSource="{Binding SongRows}"
                                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" AlternationCount="2"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                                         MouseDoubleClick="ActivateRow" PreviewKeyDown="ActivateRowFromKeyboard"
                                         ItemContainerStyle="{StaticResource SongRow}">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" />
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Song.FilePath}">
                                                <TextBlock Text="{Binding Song.DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Song.FolderName}" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Content="Reproducir selección" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        IsEnabled="{Binding CanPlaySelected}" Click="PlaySelected" />
                            </Grid>
                            <ScrollViewer VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          VerticalContentAlignment="Center" Focusable="False">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger></Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <Border CornerRadius="12" Background="{StaticResource RaisedBrush}" Padding="16">
                                    <StackPanel>
                                        <Border Width="32" Height="32" HorizontalAlignment="Left" CornerRadius="8"
                                                Background="{StaticResource HoverBrush}" Margin="0,0,0,10">
                                            <Image Width="18" Height="18" Source="{StaticResource Music}" />
                                        </Border>
                                        <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="Tu biblioteca está vacía" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImportedFolder}" Value="True">
                                                            <Setter Property="Text" Value="Sin canciones compatibles" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Notice}" Value="Importing">
                                                            <Setter Property="Text" Value="Importando carpeta…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Elige una carpeta con archivos MP3, WAV o FLAC."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <Button Content="Elegir carpeta" Click="ChooseFolder" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <views:LyricsView Grid.ColumnSpan="3" DataContext="{Binding Lyrics}">
                        <views:LyricsView.Style>
                            <Style TargetType="views:LyricsView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </views:LyricsView.Style>
                        <views:LyricsView.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" /></views:LyricsView.Resources>
                    </views:LyricsView>
                    <Border CornerRadius="13" Background="{StaticResource RaisedBrush}" Padding="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Grid.Column" Value="2" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NowPlaying}" Value="True">
                                    <Setter Property="Grid.Column" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=LyricsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CoverLabel}" Style="{StaticResource Caption}" />
                            <Image Grid.Row="1" Source="{Binding CoverImage, TargetNullValue={StaticResource Cover}}" Margin="0,16" Stretch="Uniform"
                                   MaxHeight="320" MaxWidth="320" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Row="2" FontSize="21" FontWeight="SemiBold"
                                       Text="{Binding CoverSong.DisplayName, FallbackValue=Sin pista activa}"
                                       ToolTip="{Binding CoverSong.FilePath}" />
                            <TextBlock Grid.Row="3" Text="{Binding CoverDescription}" ToolTip="{Binding CoverDescription}"
                                       Style="{StaticResource Caption}" />
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
                <Border Grid.Row="1" Margin="16,0,16,4" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="3,2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="Imported">
                                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Notice}" Value="FolderError">
                                    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                    <Setter Property="Padding" Value="10,6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Elegir otra canción" Click="ChooseAnotherSong"
                                    IsEnabled="{Binding IsReady}" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Notice}" Value="PlaybackError">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Songs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" ToolTip="{Binding StatusDetail}"
                                   AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                        <TextBlock Text="{Binding PreferencesWarning}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreferencesWarning}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Background="#0B1820" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource LibraryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1.5*" MinWidth="200" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <Image Width="44" Height="44" Margin="0,0,10,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{Binding CoverImage, TargetNullValue={StaticResource Cover}}" />
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentSong}" Value="{x:Null}">
                                    <Setter Property="Source" Value="{StaticResource Cover}" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSong.DisplayName, FallbackValue=Sin pista activa}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentSong.Metadata.Artist, FallbackValue='', TargetNullValue=''}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Transport}" Click="PlayPrevious" ToolTip="Anterior" IsEnabled="{Binding CanPrevious}">
                            <Image Source="{StaticResource Back}" Width="18" />
                        </Button>
                        <Button Style="{StaticResource PrimaryTransport}" Click="TogglePlayback" ToolTip="{Binding TransportLabel}"
                                IsEnabled="{Binding CanTogglePlayback}"
                                BorderBrush="{StaticResource AccentBrush}">
                            <Grid>
                                <Path Data="M 1,0 L 15,8 L 1,16 Z" Fill="#092A26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></Path.Style>
                                </Path>
                                <Path Data="M 0,0 h5 v16 h-5 Z M 9,0 h5 v16 h-5 Z" Fill="#092A26">
                                    <Path.Style><Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger></Style.Triggers>
                                    </Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="PlayNext" ToolTip="Siguiente" IsEnabled="{Binding CanNext}">
                            <Image Source="{StaticResource Next}" Width="18" />
                        </Button>
                        <Button Style="{StaticResource Transport}" Click="Stop" ToolTip="Detener" IsEnabled="{Binding CanStop}">
                            <Border Width="12" Height="12" Background="{StaticResource InkBrush}" CornerRadius="2" />
                        </Button>
                    </StackPanel>
                    <DockPanel Margin="0,5,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ElapsedTimeText}" Style="{StaticResource Caption}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}" />
                        <Slider x:Name="SeekSlider" Style="{StaticResource PlaybackSlider}" Margin="9,0"
                                Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="Posición de reproducción" IsEnabled="{Binding CanSeek}"
                                ValueChanged="SeekSliderChanged" IsEnabledChanged="SeekSliderEnabledChanged"
                                Thumb.DragStarted="SeekDragStarted" Thumb.DragCompleted="SeekDragCompleted" />
                    </DockPanel>
                </StackPanel>
                <DockPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"
                           IsEnabled="{Binding IsReady}">
                    <Image DockPanel.Dock="Left" Source="{StaticResource Volume}" Width="20" Margin="0,0,6,0" />
                    <TextBlock DockPanel.Dock="Right" MinWidth="32" TextAlignment="Right" Style="{StaticResource Caption}"
                               Text="{Binding VolumePercent, StringFormat={}{0}%}" />
                    <Slider Style="{StaticResource PlaybackSlider}" Width="84" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" AutomationProperties.Name="Volumen"
                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
