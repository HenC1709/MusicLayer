<Window x:Class="MusicLayer.Presentation.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicLayer" Width="640" Height="440" MinWidth="400" MinHeight="300">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Content="Elegir carpeta" Click="ChooseFolder" IsEnabled="{Binding IsReady}" HorizontalAlignment="Left" Padding="14,7" />
        <ListBox Grid.Row="1" Margin="0,16" ItemsSource="{Binding Songs}" SelectedIndex="{Binding SelectedIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2" ToolTip="{Binding FilePath}">
                        <TextBlock Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding FolderName}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2" IsEnabled="{Binding IsReady}">
            <Button Content="Anterior" Click="PlayPrevious" Padding="14,7" />
            <Button Content="Reproducir seleccionada" Click="PlaySelected" Margin="8,0" Padding="14,7" />
            <Button Content="Siguiente" Click="PlayNext" Padding="14,7" />
            <Button Content="Pausar" Click="Pause" IsEnabled="{Binding CanPause}" Margin="8,0,0,0" Padding="14,7" />
            <Button Content="Reanudar" Click="Resume" IsEnabled="{Binding CanResume}" Margin="8,0,0,0" Padding="14,7" />
            <Button Content="Detener" Click="Stop" IsEnabled="{Binding CanStop}" Margin="8,0,0,0" Padding="14,7" />
        </WrapPanel>
        <Grid Grid.Row="3" Margin="0,12,0,0" IsEnabled="{Binding IsReady}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volumen" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                    AutomationProperties.Name="Volumen"
                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" MinWidth="36" VerticalAlignment="Center" TextAlignment="Right"
                       Text="{Binding VolumePercent, StringFormat={}{0}%}" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ElapsedTimeText}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Height="6" Margin="10,0" Minimum="0" Maximum="1"
                         Foreground="#39B779" AutomationProperties.Name="Progreso de reproducción"
                         Value="{Binding ProgressFraction, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
    </Grid>
</Window>
