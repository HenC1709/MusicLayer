<UserControl x:Class="MusicLayer.Presentation.Wpf.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MusicLayer.Presentation.Wpf.Views"
             SizeChanged="ResizeView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlayerTheme.xaml" />
                <ResourceDictionary Source="../Resources/LibraryTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OptionalMetadata" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="QueueRow" TargetType="ListBoxItem" BasedOn="{StaticResource SongRow}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource LibraryAmbient}">
        <Border Background="#54041117" IsHitTestVisible="False" />
        <Grid x:Name="Layout" Margin="24,18,24,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel x:Name="Header" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Importar carpeta" Click="ImportFolder"
                        IsEnabled="{Binding IsReady}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LibraryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QueueRows.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="3" CornerRadius="2" Background="{StaticResource Mint}" Margin="0,3,13,3" />
                <TextBlock x:Name="Heading" Text="Reproducción activa" FontSize="26" FontWeight="Bold" />
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="Gutter" Width="24" />
                    <ColumnDefinition x:Name="QueueColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="HeroScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="CoverFrame" DockPanel.Dock="Left" Width="240" Height="240"
                                    CornerRadius="21" BorderBrush="#577D80" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverImage, TargetNullValue={StaticResource LibraryArtwork}}"
                                                Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border.Background>
                            </Border>
                            <StackPanel x:Name="Details" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CoverLabel}" Foreground="{StaticResource Mint}" FontSize="12" />
                                <TextBlock x:Name="TrackTitle" Text="{Binding CoverSong.DisplayName, FallbackValue=Sin pista activa}"
                                           FontSize="34" FontWeight="Bold" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"
                                           ToolTip="{Binding CoverSong.DisplayName}" />
                                <TextBlock x:Name="Artist" Text="{Binding CoverSong.Metadata.Artist, TargetNullValue='', FallbackValue=''}"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="19"
                                           Foreground="{StaticResource Muted}" FontWeight="SemiBold" Style="{StaticResource OptionalMetadata}" />
                                <TextBlock Text="{Binding CoverSong.Metadata.Album, TargetNullValue='', FallbackValue=''}"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource OptionalMetadata}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CoverSong.FileFormat, FallbackValue=''}" Margin="0,0,8,0"
                                               Foreground="{StaticResource Mint}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource OptionalMetadata}" />
                                    <TextBlock Text="{Binding CoverAudioDetails}" Foreground="{StaticResource Muted}" FontSize="12" Style="{StaticResource OptionalMetadata}" />
                                </WrapPanel>
                                <WrapPanel x:Name="Actions" Margin="0,14,0,0">
                                    <Button x:Name="PrimaryAction" Content="{Binding TransportLabel}" Click="TogglePlayback" IsEnabled="{Binding CanTogglePlayback}" MinHeight="40"
                                            Background="{StaticResource Mint}" Foreground="#092A26" FontWeight="Bold" Margin="0,0,6,4" />
                                    <ToggleButton x:Name="FavoriteAction" IsChecked="{Binding CoverRow.IsFavorite, Mode=TwoWay, FallbackValue=False}"
                                                  AutomationProperties.Name="Favorita" Margin="0,0,6,4">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource FavoriteToggle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverRow}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Button x:Name="MoreActions" Style="{StaticResource LibraryButton}" Width="40" MinHeight="40" Padding="0"
                                            IsEnabled="False" AutomationProperties.Name="Más opciones"
                                            ToolTip="Más opciones próximamente" ToolTipService.ShowOnDisabled="True" Margin="0,0,6,4">
                                        <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" />
                                    </Button>
                                    <Button Click="OpenLyrics" MinHeight="40" AutomationProperties.Name="Abrir Letras"
                                            Background="{StaticResource RaisedBrush}" BorderBrush="#385E66" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                            <TextBlock Text="Letras" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="WaveformPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <Border CornerRadius="14" Padding="14,8" BorderThickness="1" BorderBrush="#294D55">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#CC102D36" Offset="0" />
                                        <GradientStop Color="#DC0A1D27" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSong}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ElapsedTimeText}" Foreground="{StaticResource Mint}" FontSize="12" />
                                            <TextBlock Text=" / " Style="{StaticResource SmallLabel}" />
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource SmallLabel}" />
                                        </StackPanel>
                                        <TextBlock Text="Forma de onda" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <views:TrackWaveform x:Name="Waveform" TrackPath="{Binding CurrentSong.FilePath}"
                                                         Progress="{Binding ProgressFraction}" Focusable="False"
                                                         AutomationProperties.Name="Forma de onda de la pista" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="QueuePanel" Grid.Column="2" Style="{StaticResource Panel}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,2,2,9">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding QueueRows.Count}" Style="{StaticResource SmallLabel}"
                                       AutomationProperties.Name="Número de pistas" Margin="8,0,4,0" />
                            <TextBlock Text="Cola de reproducción" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding QueueRows}"
                                 SelectedItem="{Binding SelectedQueueRow, Mode=TwoWay}" Background="Transparent"
                                 BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource QueueRow}"
                                 VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Cola de reproducción" MouseDoubleClick="ActivateRow"
                                 PreviewKeyDown="ActivateRowFromKeyboard">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Song.DisplayName}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource SmallLabel}" Margin="6,0,0,0" />
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="5" ClipToBounds="True" Margin="0,0,8,0">
                                            <Image Stretch="UniformToFill" Loaded="LoadRowArt" Unloaded="UnloadRowArt" DataContextChanged="ChangeRowArt" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Song.DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Song.Metadata.Artist, TargetNullValue='', FallbackValue=''}" Style="{StaticResource SmallLabel}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="La cola está vacía" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Button Content="Importar carpeta" Click="ImportFolder" IsEnabled="{Binding IsReady}"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button Grid.Row="2" Click="PlaySelection" IsEnabled="{Binding CanPlayQueueSelected}"
                                Content="Reproducir selección" HorizontalAlignment="Left" Margin="2,5,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueRows.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
