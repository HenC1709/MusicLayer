<Window x:Class="MusicLayer.Presentation.Wpf.Views.PlaylistEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#10232B" Foreground="#F4F9F8"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlayerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" />
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#0B1922" />
                <Setter Property="Foreground" Value="#F4F9F8" />
                <Setter Property="CaretBrush" Value="#F4F9F8" />
                <Setter Property="BorderBrush" Value="#49666D" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0,3,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel x:Name="Form" Margin="20,15" KeyboardNavigation.TabNavigation="Cycle">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="23" FontWeight="Bold" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="ErrorMessage" Foreground="#FFBFB8" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Click="Save" IsDefault="True" Background="#165D4F" BorderBrush="#468674" MinWidth="90" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="Fields" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Nombre" />
                <TextBox x:Name="NameBox" AutomationProperties.Name="Nombre" MaxLength="80" />
                <TextBlock Text="Género (opcional)" />
                <TextBox x:Name="GenreBox" AutomationProperties.Name="Género" MaxLength="60" />
                <TextBlock Text="Descripción personal (opcional)" />
                <TextBox x:Name="DescriptionBox" AutomationProperties.Name="Descripción personal" MaxLength="500"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="62" Height="62" CornerRadius="5" Background="#193943" Margin="0,0,12,0">
                        <Grid ClipToBounds="True">
                            <TextBlock Text="&#xE91B;" Style="{StaticResource StatusGlyph}" />
                            <Image x:Name="CoverPreview" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Foto de portada (opcional)" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Elegir foto…" Click="ChooseCover" />
                            <Button x:Name="RemoveCoverButton" Content="Quitar foto" Click="RemoveCover"
                                    Visibility="Collapsed" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
