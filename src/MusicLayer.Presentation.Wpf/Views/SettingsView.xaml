<UserControl x:Class="MusicLayer.Presentation.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="ResizeSettings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlayerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SongScrollBar}" />
            <Style x:Key="SettingTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="0,0,0,9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Border Background="#DE0D232B" BorderBrush="#31545C" BorderThickness="1"
                                    CornerRadius="15" Padding="{DynamicResource CardPadding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Background="#123A3A" BorderBrush="#246059" BorderThickness="1"
                                            CornerRadius="9" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource StatusGlyph}" />
                                    </Border>
                                    <DockPanel>
                                        <ContentPresenter ContentSource="Header" DockPanel.Dock="{DynamicResource LabelDock}"
                                                          Width="{DynamicResource LabelWidth}" Margin="{DynamicResource LabelMargin}"
                                                          VerticalAlignment="Center" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"
                                    Background="Transparent" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SwitchTrack" Width="44" Height="24" Background="#42565D" CornerRadius="12" Padding="3">
                                        <Ellipse x:Name="Knob" Width="18" Fill="#F2FAF8" HorizontalAlignment="Left" />
                                    </Border>
                                    <TextBlock x:Name="SwitchState" Text="Desactivado" Width="76" Margin="8,0,0,0" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#158B71" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="SwitchState" Property="Text" Value="Activado" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusRing" Property="Background" Value="#163B3B" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#79E9D0" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource LibraryAmbient}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MaxWidth="1420">
                <StackPanel x:Name="SettingsBody" Margin="28,24" IsEnabled="{Binding IsReady}">
                    <DockPanel Margin="0,0,0,20">
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="#48EDBD" Margin="0,3,14,3" />
                        <TextBlock x:Name="SettingsTitle" Text="Configuración" FontWeight="Bold" FontSize="32" />
                    </DockPanel>
                    <HeaderedContentControl Tag="&#xE8B7;">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock Text="Carpeta de música" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="{Binding Library.Summary}" Style="{StaticResource Detail}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <DockPanel>
                            <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Cambiar…" Click="ChangeFolder"
                                    Style="{StaticResource StatusAction}" AutomationProperties.Name="Cambiar carpeta de música" Margin="10,0,0,0" />
                            <Border Padding="10,6" CornerRadius="8" BorderBrush="#3A555D" BorderThickness="1">
                                <TextBlock Text="{Binding LibraryFolder, TargetNullValue=Elige una carpeta}" ToolTip="{Binding LibraryFolder}" />
                            </Border>
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Tag="&#xE7E8;">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock Text="Recordar dónde me quedé" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Al abrir Tonic, pulsa Reproducir para retomar la última pista desde el punto guardado." Style="{StaticResource Detail}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <CheckBox x:Name="RememberSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Recordar dónde me quedé"
                                  IsChecked="{Binding RememberPosition}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Tag="&#xE767;">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock Text="Volumen" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Se aplica al instante y se conserva al cerrar Tonic." Style="{StaticResource Detail}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent, StringFormat={}{0} %}" Width="48" TextAlignment="Right" />
                            <Slider x:Name="SettingsVolume" Style="{StaticResource PlaybackSlider}" AutomationProperties.Name="Volumen"
                                    Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Tag="&#xE893;">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock Text="Avance automático" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Reproduce la siguiente canción de la cola cuando termina la actual." Style="{StaticResource Detail}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <CheckBox x:Name="AdvanceSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Avance automático" IsChecked="{Binding AutoAdvance}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Tag="&#xE790;">
                        <HeaderedContentControl.Header>
                            <TextBlock Text="Tema" Style="{StaticResource SettingTitle}" />
                        </HeaderedContentControl.Header>
                        <WrapPanel HorizontalAlignment="Right">
                            <Border BorderThickness="1" BorderBrush="#48EDBD" CornerRadius="8" Background="#153936" Padding="12,6" Margin="0,2,5,2">
                                <TextBlock Text="✓  Oscuro" AutomationProperties.Name="Tema oscuro, activo" />
                            </Border>
                            <Button Content="Claro" Margin="0,2,5,2" Click="ShowFutureTheme" ToolTip="Tema claro (próximamente)" />
                            <Button Content="Según el sistema" Margin="0,2" Click="ShowFutureTheme" ToolTip="Tema del sistema (próximamente)" />
                        </WrapPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Tag="&#xE8A4;">
                        <HeaderedContentControl.Header>
                            <TextBlock Text="Letras" Style="{StaticResource SettingTitle}" />
                        </HeaderedContentControl.Header>
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="FollowSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Seguir el verso actual" IsChecked="{Binding FollowLyrics}" />
                                <TextBlock Text="Seguir el verso actual" TextWrapping="Wrap" />
                            </DockPanel>
                            <Border Height="1" Background="#304A50" Margin="0,4" />
                            <DockPanel>
                                <CheckBox x:Name="DimSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Atenuar los demás versos" IsChecked="{Binding DimInactiveLyrics}" />
                                <TextBlock Text="Atenuar los demás versos" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
